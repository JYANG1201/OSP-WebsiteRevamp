---
import '../styles/global.css';
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';
import { SITE_NAME, DEFAULT_OG_IMAGE, GTM_ID, PRODUCTION_HOST, organization, website } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /* Absolute or root-relative image for social previews. */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  /* Page-specific schema.org nodes, merged into one @graph with the
     site-wide Organization and WebSite nodes. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = '',
  image = DEFAULT_OG_IMAGE,
  type = 'website',
  publishedTime,
  noindex = false,
  schema = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [organization, website, ...schema] });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_MY" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- hero headlines (LCP on text heroes / blog posts) use this weight -->
    <link rel="preload" href={poppins700} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href="/images/logo/osp-logo2-white.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Mobile: hero copy visible at first paint (the pages' .sig-anim rules
         hide it until the GSAP intro runs, which delayed mobile LCP 1.3-1.9s);
         heroIntro() adds only a transform-only rise on these widths. -->
    <style is:inline>
      @media (max-width: 860px) {
        .sig-anim [data-hero-el], .sig-anim [data-hero-line] { opacity: 1 !important; }
        #sig-loader { display: none !important; }
      }
    </style>

    <script is:inline define:vars={{ GTM_ID, PRODUCTION_HOST }}>
      /* Also load when GTM Preview / Tag Assistant opens the page (it adds
         ?gtm_debug=), so tags can be tested on the preview before launch. */
      if (location.hostname === PRODUCTION_HOST || location.search.indexOf('gtm_debug=') !== -1) {
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', GTM_ID);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
