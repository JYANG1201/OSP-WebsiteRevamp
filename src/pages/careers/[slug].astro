---
import Layout from '../../layouts/Layout.astro';
import { ClientRouter } from 'astro:transitions';
import { getCollection, render } from 'astro:content';

import SignalGlobalStyles from '../../components/direction-2/SignalGlobalStyles.astro';
import CursorGlow from '../../components/direction-2/CursorGlow.tsx';
import SiteNav from '../../components/direction-2/SiteNav.astro';
import SiteFooter from '../../components/direction-2/SiteFooter.astro';
import WhatsAppButton from '../../components/direction-2/WhatsAppButton.astro';
import SignalRuntime from '../../components/direction-2/SignalRuntime.astro';

export async function getStaticPaths() {
  const positions = await getCollection('careers');
  return positions.map((position) => ({
    params: { slug: position.id },
    props: { position },
  }));
}

const { position } = Astro.props;
const { Content } = await render(position);

const { title, titleHighlight } = position.data;
const hlIndex = title.indexOf(titleHighlight);
const titleBefore = hlIndex >= 0 ? title.slice(0, hlIndex) : title;
const titleAfter = hlIndex >= 0 ? title.slice(hlIndex + titleHighlight.length) : '';
---

<Layout title={`${position.data.title} — Careers at One Search Pro`} description={position.data.excerpt}>
  <ClientRouter />
  <SignalGlobalStyles />

  <CursorGlow client:media="(pointer: fine)" />

  <div class="sig-atmos" aria-hidden="true">
    <div class="sig-atmos__glow"></div>
    <div class="sig-atmos__grain"></div>
  </div>

  <div class="sig-page">
    <SiteNav />
    <main id="main">
      <article class="sig-job">
        <section class="sig-job__hero">
          <div class="sig-job__media" aria-hidden="true">
            <video class="sig-job__video" autoplay muted loop playsinline poster="/images/posters/career-hero.jpg">
              <source src="/videos/career-hero-m.mp4" type="video/mp4" media="(max-width: 860px)" />
              <source src="/videos/career-hero.mp4" type="video/mp4" />
            </video>
            <div class="sig-job__scrim"></div>
          </div>
          <div class="sig-shell sig-job__head" data-hero>
            <a class="sig-link sig-job__back" href="/contact/#careers">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M13 7H2M6 3 2 7l4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Back to Open Positions
            </a>
            <h1 class="sig-h1 sig-job__title">
              <span class="sig-job__line"><i data-hero-line>{titleBefore}<em>{titleHighlight}</em>{titleAfter}</i></span>
            </h1>
            <p class="sig-job__excerpt" data-hero-el>{position.data.excerpt}</p>
            <a class="sig-btn sig-btn--primary sig-job__apply" href="mailto:hr@onesearchpro.my" data-hero-el data-glow-target>
              Apply Now
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </section>

        <div class="sig-shell sig-job__bodywrap">
          <div class="sig-job__body" data-r>
            <Content />
          </div>

          <div class="sig-job__ctapanel sig-glass" data-r data-tilt="2">
            <h2 class="sig-h3 sig-job__ctatitle">Ready to apply?</h2>
            <p class="sig-body">Send your resume to <a class="sig-job__ctalink" href="mailto:hr@onesearchpro.my">hr@onesearchpro.my</a> and we'll be in touch.</p>
            <a class="sig-btn sig-btn--primary" href="mailto:hr@onesearchpro.my" data-glow-target>
              Apply Now
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </article>
    </main>
    <SiteFooter />
  </div>

  <WhatsAppButton />

  <SignalRuntime />

  <style>
    .sig-job__hero {
      position: relative;
      overflow: hidden;
    }
    /* own dedicated footage (career-hero.mp4) — previously shared with
       the Blog/Contact heroes via blog-hero.mp4, split out into its own
       file so a future change to one page's video can't silently change
       this one too. */
    .sig-job__media { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .sig-job__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
    .sig-job__scrim {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(100deg, rgba(5, 5, 5, 0.82) 0%, rgba(5, 5, 5, 0.66) 45%, rgba(5, 5, 5, 0.55) 100%),
        linear-gradient(180deg, rgba(5, 5, 5, 0.2) 0%, transparent 35%, transparent 60%, rgba(5, 5, 5, 0.97) 100%);
    }
    .sig-job__head {
      position: relative;
      z-index: 2;
      padding-top: clamp(7rem, 16vh, 9.5rem);
      padding-bottom: var(--sig-section);
      margin-bottom: var(--sig-hero-gap);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }
    .sig-job__back { margin-bottom: 0.75rem; }
    .sig-job__title { color: #fff; max-width: 28ch; }
    .sig-job__title em {
      font-style: normal;
      background-image:
        linear-gradient(100deg, transparent 40%, rgba(255, 255, 255, 0.85) 50%, transparent 60%),
        linear-gradient(90deg, var(--color-brand-primary), var(--color-brand-accent));
      background-size: 220% 100%, 100% 100%;
      background-position: var(--shine, -120%) 0, 0 0;
      background-repeat: no-repeat, no-repeat;
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      text-shadow: none;
      filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
    }
    .sig-job__line { display: block; overflow: hidden; padding-bottom: 0.16em; margin-bottom: -0.16em; }
    .sig-job__line i { display: block; font-style: normal; }
    .sig-job__excerpt { font-size: 1rem; line-height: 1.65; color: rgba(237, 237, 237, 0.68); max-width: 60ch; }
    .sig-job__apply { margin-top: 0.5rem; }

    .sig-job__bodywrap {
      padding-top: var(--sig-section);
      padding-bottom: var(--sig-section);
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      gap: clamp(2rem, 5vw, 3.5rem);
      align-items: start;
    }
    .sig-job__body { font-size: 1rem; line-height: 1.85; color: rgba(237, 237, 237, 0.78); }
    .sig-job__body :global(h1) { display: none; }
    .sig-job__body :global(h2) {
      font-family: var(--font-heading); font-weight: 700; font-size: clamp(1.2rem, 2vw, 1.5rem);
      letter-spacing: -0.01em; color: var(--color-brand-primary); text-transform: uppercase;
      margin: 2em 0 0.9em;
    }
    /* :first-of-type (not :first-child) — the markdown's own hidden
       <h1> title is still the literal first DOM child before this
       h2, so :first-child never matched and "RESPONSIBILITIES" kept
       its full default top margin, pushing it below the CTA panel's
       flush top edge. */
    .sig-job__body :global(h2:first-of-type) { margin-top: 0; }
    .sig-job__body :global(p) { margin: 0 0 1.2em; }
    .sig-job__body :global(ul) { margin: 0 0 1.4em; padding-left: 1.3em; display: flex; flex-direction: column; gap: 0.6em; }
    .sig-job__body :global(strong) { color: #fff; font-weight: 600; }

    .sig-job__ctapanel {
      /* position:sticky, per direct request — the panel now stays in
         view on the right while "Responsibilities"/"Requirements"/
         "Benefits" scroll past on the left, un-sticking once that
         column's content ends. Note: a sticky element can only ever
         pixel-align with a non-sticky sibling ("Responsibilities") at
         one exact scroll offset, not throughout — that alignment goal
         was tried and abandoned earlier; this time the ask is just the
         standard sticky-sidebar behavior itself, so that trade-off is
         expected and accepted. top clears the fixed nav's own height
         once it has revealed (nav is hidden until scroll, but any
         scroll far enough to reach this section will have already
         revealed it). */
      position: sticky;
      top: clamp(6rem, 12vh, 7.5rem);
      margin-top: 15px;
      padding: calc(clamp(1.75rem, 3vw, 2.25rem) - 4px) clamp(1.75rem, 3vw, 2.25rem) clamp(1.75rem, 3vw, 2.25rem);
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .sig-job__ctatitle { color: #fff; margin-top: 0; }
    .sig-job__ctalink { color: var(--color-brand-accent); text-decoration: underline; text-underline-offset: 3px; }

    @media (max-width: 860px) {
      .sig-job__bodywrap { grid-template-columns: 1fr; }
      /* single-column stack — sticky has no meaningful room to work
         with here (the panel is its own full-height row), so drop it
         explicitly rather than rely on that being a no-op */
      .sig-job__ctapanel { position: static; }
    }
    @media (max-width: 640px) {
      .sig-job__head { padding-top: 6.5rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .sig-job__video { display: none; }
    }
  </style>
</Layout>
