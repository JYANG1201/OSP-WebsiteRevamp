---
import SectionHead from './SectionHead.astro';

/*
  SIGNAL · Creative process
  ─────────────────────────────────────────────────────────────
  Same process mechanic as Process/SeoProcess/DigitalProcess —
  SignalRuntime scrubs [data-process-line] and lights each
  .sig-step as it enters. Adds the same closing "the cycle
  continues" line as the Digital Strategy page.
*/

const steps = [
  {
    idx: '01',
    title: 'Diagnose & Plan',
    body: 'We begin by understanding your business, objectives, requirements and expectations — making sure everyone is aligned before the work begins.',
  },
  {
    idx: '02',
    title: 'Setting & Preparation',
    body: 'With the direction confirmed, our team prepares the strategy, resources, content, assets and technical requirements needed for execution.',
  },
  {
    idx: '03',
    title: 'Action & Build',
    body: 'Once everything is ready and approved, we bring the strategy to life — from campaigns and content to creative, websites and other digital solutions.',
  },
  {
    idx: '04',
    title: 'Reporting & Review',
    body: "See what's working. We review progress, performance and key outcomes to give you a clearer picture of what has been achieved and where the next opportunities are.",
  },
];
---

<section class="sig-section sig-cproc" id="creative-process">
  <div class="sig-shell">
    <div class="sig-process__pin" data-process-pin data-process-scroll="0.4">
      <SectionHead title="HOW WE <em>WORK</em>" />

      <div class="sig-cproc__track" data-process>
        <div class="sig-cproc__rail" aria-hidden="true">
          <span data-process-line></span>
          <i class="sig-cproc__marker" data-process-marker></i>
        </div>

        <ol class="sig-cproc__steps">
          {
            steps.map((s) => (
              <li class="sig-step">
                <div class="sig-step__node" aria-hidden="true">
                  <i></i>
                </div>
                <h3 class="sig-step__title">
                  <em>{s.idx}</em>
                  {s.title}
                </h3>
                <p class="sig-step__body sig-body">{s.body}</p>
              </li>
            ))
          }
        </ol>

        <p class="sig-cproc__cycle">
          <strong>And the cycle continues.</strong>
          <span>Scroll For More Wonders&gt;&gt;&gt;</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .sig-cproc__track {
    position: relative;
    margin-top: clamp(3rem, 7vh, 5rem);
  }

  /* the rail that draws itself as you scroll (scrubbed by SignalRuntime) */
  .sig-cproc__rail {
    position: absolute;
    top: 19px;
    left: 0;
    right: 0;
    height: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.075);
  }
  .sig-cproc__rail span {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: 999px;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(90deg, var(--color-brand-primary), var(--color-brand-accent));
    box-shadow: 0 0 28px rgba(255, 107, 53, 0.75), 0 0 10px rgba(255, 176, 32, 0.6);
  }

  /* the comet that travels the rail in sync with scroll progress */
  .sig-cproc__marker {
    position: absolute;
    top: 50%;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 6px 2px rgba(255, 255, 255, 0.9),
                0 0 22px 6px rgba(255, 107, 53, 0.85),
                0 0 40px 12px rgba(255, 176, 32, 0.5);
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    will-change: left;
  }
  .sig-cproc__marker.is-active { opacity: 1; }

  .sig-cproc__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.4vw, 2.5rem);
  }

  .sig-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-right: clamp(0.5rem, 1.5vw, 1.5rem);
  }

  .sig-step__node {
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(155deg, rgba(23, 20, 15, 0.92), rgba(6, 6, 6, 0.8));
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 0.85rem;
    transition: border-color 0.55s ease, box-shadow 0.55s ease;
  }
  .sig-step__node i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 107, 53, 0.35);
    transition: background-color 0.55s ease, box-shadow 0.55s ease, transform 0.55s ease;
  }
  .sig-step:hover .sig-step__node,
  .sig-step.is-live .sig-step__node {
    border-color: rgba(255, 107, 53, 0.45);
    box-shadow: 0 0 0 6px rgba(255, 107, 53, 0.06);
  }
  .sig-step:hover .sig-step__node i,
  .sig-step.is-live .sig-step__node i {
    background: var(--color-brand-primary);
    box-shadow: 0 0 14px rgba(255, 107, 53, 0.9);
    transform: scale(1.15);
  }

  .sig-step__title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.6vw, 1.42rem);
    letter-spacing: -0.028em;
    color: #fff;
  }
  .sig-step__title em {
    font-style: normal;
    font-size: 0.55em;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: rgba(255, 107, 53, 0.8);
    font-variant-numeric: tabular-nums;
  }
  .sig-step__body { max-width: 32ch; }

  /* ── closing tagline ────────────────────────────────────── */
  .sig-cproc__cycle {
    margin: clamp(1.5rem, 3.5vh, 2.5rem) 0 0;
    padding-top: clamp(1.25rem, 2.5vh, 1.75rem);
    border-top: 1px solid rgba(255, 255, 255, 0.075);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .sig-cproc__cycle strong {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.05rem, 1.4vw, 1.28rem);
    letter-spacing: -0.015em;
    color: #fff;
  }
  .sig-cproc__cycle span {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-primary);
  }

  @media (max-width: 1080px) {
    .sig-cproc__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.75rem; }
    .sig-cproc__rail { display: none; }
  }
  @media (max-width: 620px) {
    /* vertical rail on mobile */
    .sig-cproc__steps { grid-template-columns: 1fr; row-gap: 0; }
    .sig-step {
      padding-left: 3.65rem;
      padding-bottom: 2.25rem;
    }
    .sig-step__node {
      position: absolute;
      left: 0;
      top: 0;
      margin: 0;
    }
    .sig-step::before {
      content: '';
      position: absolute;
      left: 19.5px;
      top: 46px;
      bottom: -4px;
      width: 3px;
      border-radius: 999px;
      background: linear-gradient(180deg, var(--color-brand-primary), rgba(255, 176, 32, 0.15));
      box-shadow: 0 0 16px rgba(255, 107, 53, 0.55);
    }
    .sig-step:last-child::before { display: none; }
    .sig-cproc__cycle {
      margin-top: 1rem;
      padding-top: 0.85rem;
    }
  }
</style>
