---
import SectionHead from './SectionHead.astro';

const services = [
  {
    href: '/seo/',
    name: 'Search Engine Optimization (SEO)',
    claim: 'Get found when it matters.',
    points: ['Technical SEO · On-Page SEO · Off-Page SEO', 'Local SEO · E-commerce SEO', 'GEO & AI-SEO'],
    icon: 'search',
    image: '/images/services/seo.jpg',
  },
  {
    href: '/digital-strategy/',
    name: 'Digital Strategy Solutions (Social Media)',
    claim: 'Turn searches into opportunities.',
    points: ['Google Search Ads', 'Performance Campaigns', 'Lead Generation'],
    icon: 'strategy',
    image: '/images/services/social-media.jpg',
  },
  {
    href: '/creative/',
    name: 'Creative Digital Solutions',
    claim: 'Tell your story strategically & creatively.',
    points: ['Creative Branding & Identity', 'AIEC Content & Video Creation', 'Web design & development'],
    icon: 'creative',
    image: '/images/services/creative.jpg',
  },
];
---

<section class="sig-section sig-services" id="services">
  <div class="sig-shell">
    <div class="sig-services__head">
      <SectionHead title="Everything Your Brand Needs to <em>Grow Online.</em>" />
    </div>

    <div class="sig-services__grid" data-stagger>
      {
        services.map((s) => (
          <a class="sig-svc sig-glass" href={s.href} data-tilt="4.5" data-glow-target data-r-item>
            <div class="sig-svc__img">
              <img src={s.image} alt={`${s.name} — One Search Pro`} loading="lazy" decoding="async" />
            </div>

            <div class="sig-svc__inner">
              <div class="sig-svc__top">
                <h3 class="sig-svc__name">{s.name}</h3>
                <span class="sig-svc__icon" aria-hidden="true">
                  {s.icon === 'search' && (
                    <svg viewBox="0 0 32 32" fill="none">
                      <circle cx="14" cy="14" r="8.5" stroke="currentColor" stroke-width="1.3" />
                      <path d="M20.4 20.4 27 27" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                      <path d="M9 16.5c1.6-4 3.4-6 5.4-6s3 1.6 4.6 4.4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.55" />
                    </svg>
                  )}
                  {s.icon === 'strategy' && (
                    <svg viewBox="0 0 32 32" fill="none">
                      <path d="M4 26h24" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                      <path d="M4 21.5l7-6.5 5 3.6L27 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                      <path d="M21.5 6H27v5.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                      <circle cx="11" cy="15" r="1.8" fill="currentColor" opacity="0.55" />
                    </svg>
                  )}
                  {s.icon === 'creative' && (
                    <svg viewBox="0 0 32 32" fill="none">
                      <path d="M16 4.5 19 12l7.5 3-7.5 3-3 7.5-3-7.5L5.5 15 13 12z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                      <path d="M25 5.5v4M23 7.5h4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.6" />
                    </svg>
                  )}
                </span>
              </div>

              <p class="sig-svc__claim">{s.claim}</p>

              <ul class="sig-svc__points">
                {s.points.map((p) => (
                  <li>
                    <span class="sig-svc__tick" aria-hidden="true"></span>
                    {p}
                  </li>
                ))}
              </ul>

              <span class="sig-svc__cta">
                <span>
                  Explore {s.name}
                  <svg class="sig-svc__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sig-services__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem 3rem;
    flex-wrap: wrap;
    padding-bottom: clamp(2.75rem, 6vh, 4.5rem);
  }
  .sig-services__all { padding-bottom: 6px; }

  .sig-services__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.6rem);
    perspective: 1600px;
  }

  .sig-svc {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }
  /* thin scanning line across the card top on hover */
  .sig-svc::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, transparent, var(--color-brand-primary), transparent);
    transform: translateX(-100%);
    transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-svc:hover::before { transform: translateX(100%); }

  /* ── the card's imagery ───────────────────────────────────── */
  .sig-svc__img {
    position: relative;
    z-index: 1;
    display: block;
    flex: none;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    opacity: 0.92;
  }
  .sig-svc__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .sig-svc:hover .sig-svc__img {
    transform: scale(1.035);
    opacity: 1;
  }

  .sig-svc__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    flex: 1;
    padding: clamp(1.5rem, 2.2vw, 2rem);
  }

  .sig-svc__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .sig-svc__name {
    flex: 1;
    min-width: 0;
  }
  .sig-svc__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 12px;
    border: 1px solid rgba(255, 107, 53, 0.22);
    background: radial-gradient(120% 120% at 30% 0%, rgba(255, 107, 53, 0.16), rgba(255, 107, 53, 0.03));
    color: var(--color-brand-accent);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.5s ease, color 0.5s ease;
  }
  .sig-svc__icon svg { width: 19px; height: 19px; }
  .sig-svc:hover .sig-svc__icon {
    transform: translateY(-3px) scale(1.04);
    border-color: rgba(255, 107, 53, 0.5);
    color: #fff;
  }

  .sig-svc__name {
    font-family: var(--font-heading);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--color-brand-primary);
  }
  .sig-svc__claim {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.24rem, 1.65vw, 1.5rem);
    line-height: 1.22;
    letter-spacing: -0.028em;
    color: #fff;
    max-width: 18ch;
  }

  .sig-svc__points {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 1.35rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .sig-svc__points li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.815rem;
    font-weight: 300;
    letter-spacing: 0.005em;
    color: rgba(237, 237, 237, 0.72);
  }
  .sig-svc__tick {
    flex: none;
    width: 14px;
    height: 1px;
    background: var(--color-brand-primary);
    opacity: 0.75;
  }

  .sig-svc__cta {
    margin-top: auto;
    padding-top: 1.6rem;
    display: block;
    width: 100%;
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: rgba(237, 237, 237, 0.75);
    transition: color 0.4s ease;
  }
  .sig-svc__cta span {
    position: relative;
  }
  .sig-svc__arrow {
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.5rem;
  }
  .sig-svc__cta span::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    height: 1px;
    width: 100%;
    background: var(--color-brand-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-svc__cta svg { transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
  .sig-svc:hover .sig-svc__cta { color: #fff; }
  .sig-svc:hover .sig-svc__cta span::after { transform: scaleX(1); }
  .sig-svc:hover .sig-svc__cta svg { transform: translateX(4px); }

  @media (max-width: 1080px) {
    .sig-services__grid { grid-template-columns: 1fr; }
    .sig-svc__claim { max-width: 24ch; }
  }
  @media (max-width: 640px) {
    .sig-svc { border-radius: var(--sig-r-md); }
  }
</style>
