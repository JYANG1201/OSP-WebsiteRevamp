---
import { seoServices } from '../../data/seo-services';
import { digitalServices } from '../../data/digital-services';
import { creativeServices } from '../../data/creative-services';

const serviceColumns = [
  {
    title: 'SEO',
    href: '/seo',
    links: seoServices.map((s) => ({ label: s.name, href: `/seo/${s.slug}` })),
  },
  {
    title: 'Digital Strategy',
    href: '/digital-strategy',
    links: digitalServices.map((s) => ({ label: s.name, href: `/digital-strategy/${s.slug}` })),
  },
  {
    title: 'Creative',
    href: '/creative',
    links: creativeServices.map((s) => ({ label: s.name, href: `/creative/${s.slug}` })),
  },
];

const companyColumn = {
  title: 'Company',
  links: [
    { label: 'Home', href: '/' },
    { label: 'About Us', href: '/about' },
    { label: 'Blog', href: '/blog' },
    { label: 'Contact', href: '/contact' },
  ],
};

const socials = [
  {
    label: 'LinkedIn',
    href: 'https://my.linkedin.com/company/one-search-pro',
    path: 'M3.2 6.4h2.6V14H3.2V6.4Zm1.3-3.6a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM7.6 6.4h2.5v1.04h.04c.35-.63 1.2-1.24 2.35-1.24 1.98 0 2.55 1.22 2.55 3.06V14h-2.6v-3.9c0-.93-.36-1.5-1.15-1.5-.86 0-1.24.58-1.24 1.53V14H7.6V6.4Z',
  },
  {
