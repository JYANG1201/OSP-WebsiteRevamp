    path: 'M15.3 5.9a1.9 1.9 0 0 0-1.33-1.35C12.8 4.25 9 4.25 9 4.25s-3.8 0-4.97.3A1.9 1.9 0 0 0 2.7 5.9C2.4 7.08 2.4 9 2.4 9s0 1.92.3 3.1a1.9 1.9 0 0 0 1.33 1.35c1.17.3 4.97.3 4.97.3s3.8 0 4.97-.3a1.9 1.9 0 0 0 1.33-1.35c.3-1.18.3-3.1.3-3.1s0-1.92-.3-3.1ZM7.75 11.2V6.8L11.6 9l-3.85 2.2Z',
  },
