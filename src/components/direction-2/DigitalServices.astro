---
import SectionHead from './SectionHead.astro';
import { digitalServices as pillars } from '../../data/digital-services';

/*
  SIGNAL · Digital Strategy service pillars
  ─────────────────────────────────────────────────────────────
  Same card grammar as SeoServices — three glass cards, each
  fronted by its own placeholder plate. Content lives in
  src/data/digital-services.ts, shared with each card's real
  subpage (src/pages/digital-strategy/[slug].astro) and the nav
  dropdown.
*/
---

<section class="sig-section sig-dpillars" id="digital-services">
  <div class="sig-dpillars__head">
    <div class="sig-shell sig-dpillars__headinner">
      <SectionHead title="OUR DIGITAL MARKETING <em>SOLUTIONS</em>" />
      <div class="sig-dpillars__ctas">
        <a class="sig-btn sig-btn--primary sig-btn--sm" href="#digital-cta">
          Get a Digital Strategy Consultation
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a class="sig-btn sig-btn--ghost sig-btn--sm" href="https://wa.me/60330095621" target="_blank" rel="noopener">
          Talk To Our Specialist
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="sig-shell">
    <div class="sig-dpillars__grid" data-stagger data-stagger-amount="0.12">
      {
        pillars.map((p) => (
          <a class="sig-dpill sig-glass" href={`/digital-strategy/${p.slug}/`} data-tilt="4" data-glow-target data-r-item>
            <span class="sig-dpill__edge" aria-hidden="true"></span>

            <div class="sig-dpill__img">
              <img src={p.image} alt={`${p.name} — One Search Pro`} loading="lazy" decoding="async" />
            </div>

            <div class="sig-dpill__inner">
            <div class="sig-dpill__top">
              <h3 class="sig-dpill__name"><em>{p.idx}</em>{p.name}</h3>
              <span class="sig-dpill__icon" aria-hidden="true">
                {p.icon === 'social' && (
                  <svg viewBox="0 0 32 32" fill="none">
                    <path d="M6 8.5h20a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H14l-5.5 5v-5H6a2 2 0 0 1-2-2v-10a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                    <path d="M16 17.2c-2.6-1.6-3.8-3-3.8-4.5a2.1 2.1 0 0 1 3.8-1.3 2.1 2.1 0 0 1 3.8 1.3c0 1.5-1.2 2.9-3.8 4.5Z" stroke="currentColor" stroke-width="1.15" stroke-linejoin="round" opacity="0.75" />
                  </svg>
                )}
                {p.icon === 'sem' && (
                  <svg viewBox="0 0 32 32" fill="none">
                    <circle cx="13" cy="13" r="8" stroke="currentColor" stroke-width="1.3" />
                    <path d="M19 19 26.5 26.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                    <path d="M22 9 27 4M27 4h-4M27 4v4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" opacity="0.6" />
                  </svg>
                )}
                {p.icon === 'kol' && (
                  <svg viewBox="0 0 32 32" fill="none">
                    <circle cx="14" cy="11" r="4.5" stroke="currentColor" stroke-width="1.3" />
                    <path d="M6 26c0-5 3.6-8.5 8-8.5s8 3.5 8 8.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                    <path d="M24.5 13.5l1.3 2.7 3 .4-2.2 2.1.5 3-2.6-1.5-2.6 1.5.5-3-2.2-2.1 3-.4Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" opacity="0.7" />
                  </svg>
                )}
              </span>
            </div>

            <p class="sig-dpill__claim">{p.claim}</p>

            <ul class="sig-dpill__subs">
              {p.subs.map((s) => (
                <li>
                  <span class="sig-dpill__tick" aria-hidden="true"></span>
                  <span class="sig-dpill__subname">{s}</span>
                </li>
              ))}
            </ul>

            <span class="sig-dpill__cta">
              <span>
                View Full Service Scope
                <svg class="sig-dpill__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sig-dpillars__head { padding-bottom: clamp(2.75rem, 6vh, 4.5rem); }
  .sig-dpillars__headinner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem 3rem;
    flex-wrap: wrap;
  }
  .sig-dpillars__headinner > :global(.sig-head) {
    flex: 1 1 0%;
    min-width: 0;
  }
  .sig-dpillars__ctas {
    display: flex;
    flex: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .sig-dpillars__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.6rem);
    perspective: 1600px;
  }
  .sig-dpill {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  /* hairline that sweeps the top edge on hover */
  .sig-dpill__edge {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, transparent, var(--color-brand-primary), transparent);
    transform: translateX(-100%);
    transition: transform 1.15s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  .sig-dpill:hover .sig-dpill__edge { transform: translateX(100%); }

  /* ── the pillar's imagery ───────────────────────────────────── */
  .sig-dpill__img {
    position: relative;
    z-index: 1;
    flex: none;
    opacity: 0.92;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-dpill__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .sig-dpill:hover .sig-dpill__img { transform: scale(1.035); opacity: 1; }

  .sig-dpill__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    flex: 1;
    padding: clamp(1.5rem, 2.2vw, 2rem);
  }

  .sig-dpill__top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .sig-dpill__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 12px;
    border: 1px solid rgba(255, 107, 53, 0.22);
    background: radial-gradient(120% 120% at 30% 0%, rgba(255, 107, 53, 0.16), rgba(255, 107, 53, 0.03));
    color: var(--color-brand-accent);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.5s ease, color 0.5s ease;
  }
  .sig-dpill__icon svg { width: 19px; height: 19px; }
  .sig-dpill:hover .sig-dpill__icon {
    transform: translateY(-3px) scale(1.04);
    border-color: rgba(255, 107, 53, 0.5);
    color: #fff;
  }

  .sig-dpill__name {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex: 1;
    min-width: 0;
    font-family: var(--font-heading);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--color-brand-primary);
  }
  .sig-dpill__name em {
    font-style: normal;
    font-size: 1.1em;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: rgba(255, 107, 53, 0.55);
    font-variant-numeric: tabular-nums;
  }
  .sig-dpill__claim {
    position: relative;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.24rem, 1.65vw, 1.5rem);
    line-height: 1.22;
    letter-spacing: -0.028em;
    color: #fff;
    max-width: 19ch;
  }
  .sig-dpill__subs {
    position: relative;
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 1.35rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .sig-dpill__subs li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .sig-dpill__tick {
    flex: none;
    width: 14px;
    height: 1px;
    background: var(--color-brand-primary);
    opacity: 0.8;
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-dpill:hover .sig-dpill__tick { width: 22px; }
  .sig-dpill__subname {
    font-size: 0.815rem;
    font-weight: 300;
    letter-spacing: 0.005em;
    color: rgba(237, 237, 237, 0.72);
  }

  .sig-dpill__cta {
    position: relative;
    margin-top: auto;
    padding-top: 1.6rem;
    display: block;
    width: 100%;
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: rgba(237, 237, 237, 0.75);
    transition: color 0.4s ease;
  }
  .sig-dpill__cta span { position: relative; }
  .sig-dpill__cta span::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    height: 1px;
    width: 100%;
    background: var(--color-brand-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-dpill__arrow,
  .sig-dpill__cta svg { display: inline-block; vertical-align: middle; margin-left: 0.5rem; transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
  .sig-dpill:hover .sig-dpill__cta { color: #fff; }
  .sig-dpill:hover .sig-dpill__cta span::after { transform: scaleX(1); }
  .sig-dpill:hover .sig-dpill__cta svg { transform: translateX(4px); }

  @media (max-width: 1080px) {
    .sig-dpillars__grid { grid-template-columns: 1fr; }
    .sig-dpill__claim { max-width: 26ch; }
  }
  @media (max-width: 640px) {
    .sig-dpill { border-radius: var(--sig-r-md); }
    /* the two-button group won't shrink (flex: none above), so once
       the title wraps to its own line, stack the buttons full-width
       instead of letting them overflow past the screen edge */
    .sig-dpillars__ctas {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .sig-dpillars__ctas .sig-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
