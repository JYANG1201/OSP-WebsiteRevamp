---
import SectionHead from './SectionHead.astro';
import { creativeServices as pillars } from '../../data/creative-services';

/*
  SIGNAL · Creative service pillars
  ─────────────────────────────────────────────────────────────
  Same card grammar as SeoServices/DigitalServices — three glass
  cards, each fronted by its own placeholder plate. Content lives
  in src/data/creative-services.ts, shared with each card's real
  subpage (src/pages/creative/[slug].astro) and the nav dropdown.
*/
---

<section class="sig-section sig-cpillars" id="creative-services">
  <div class="sig-cpillars__head">
    <div class="sig-shell sig-cpillars__headinner">
      <SectionHead title="OUR CREATIVE <em>SOLUTIONS</em>" />
      <div class="sig-cpillars__ctas">
        <a class="sig-btn sig-btn--primary sig-btn--sm" href="#creative-cta">
          Get a Creative Consultation
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a class="sig-btn sig-btn--ghost sig-btn--sm" href="https://wa.me/60330095621" target="_blank" rel="noopener">
          Talk To Our Specialist
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="sig-shell">
    <div class="sig-cpillars__grid" data-stagger data-stagger-amount="0.12">
      {
        pillars.map((p) => (
          <a class="sig-cpill sig-glass" href={`/creative/${p.slug}/`} data-tilt="4" data-glow-target data-r-item>
            <span class="sig-cpill__edge" aria-hidden="true"></span>

            <div class="sig-cpill__img">
              <img src={p.image} alt={`${p.name} — One Search Pro`} loading="lazy" decoding="async" />
            </div>

            <div class="sig-cpill__inner">
            <div class="sig-cpill__top">
              <h3 class="sig-cpill__name"><em>{p.idx}</em>{p.name}</h3>
              <span class="sig-cpill__icon" aria-hidden="true">
                {p.icon === 'video' && (
                  <svg viewBox="0 0 32 32" fill="none">
                    <rect x="4.5" y="7.5" width="23" height="17" rx="3.5" stroke="currentColor" stroke-width="1.3" />
                    <path d="M13.5 12.5v7l6-3.5-6-3.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" fill="currentColor" fill-opacity="0.12" />
                  </svg>
                )}
                {p.icon === 'website' && (
                  <svg viewBox="0 0 32 32" fill="none">
                    <rect x="4.5" y="6.5" width="23" height="19" rx="3" stroke="currentColor" stroke-width="1.3" />
                    <path d="M4.5 12h23" stroke="currentColor" stroke-width="1.3" />
                    <circle cx="8" cy="9.25" r="0.85" fill="currentColor" opacity="0.7" />
                    <rect x="9" y="16" width="6.5" height="6" rx="1" stroke="currentColor" stroke-width="1.1" opacity="0.6" />
                    <rect x="17.5" y="16" width="6.5" height="6" rx="1" stroke="currentColor" stroke-width="1.1" opacity="0.6" />
                  </svg>
                )}
                {p.icon === 'branding' && (
                  <svg viewBox="0 0 32 32" fill="none">
                    <path d="M22.5 4.5 27.5 9.5 14 23 8 25l2-6Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                    <path d="M19 8 24 13" stroke="currentColor" stroke-width="1.1" opacity="0.6" />
                    <circle cx="9.7" cy="23.7" r="1" fill="currentColor" opacity="0.55" />
                  </svg>
                )}
              </span>
            </div>

            <p class="sig-cpill__claim">{p.claim}</p>

            <ul class="sig-cpill__subs">
              {p.subs.map((s) => (
                <li>
                  <span class="sig-cpill__tick" aria-hidden="true"></span>
                  <span class="sig-cpill__subname">{s}</span>
                </li>
              ))}
            </ul>

            <span class="sig-cpill__cta">
              <span>
                View Full Service Scope
                <svg class="sig-cpill__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sig-cpillars__head { padding-bottom: clamp(2.75rem, 6vh, 4.5rem); }
  .sig-cpillars__headinner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem 3rem;
    flex-wrap: wrap;
  }
  /* lets the title shrink below its preferred width and wrap onto
     however many lines fit in whatever room the CTAs leave, instead
     of the default min-width:auto forcing the whole row to wrap the
     moment the title's natural width plus the CTAs' width overflows */
  .sig-cpillars__headinner > :global(.sig-head) {
    flex: 1 1 0%;
    min-width: 0;
  }
  .sig-cpillars__ctas {
    display: flex;
    flex: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .sig-cpillars__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.6rem);
    perspective: 1600px;
  }

  .sig-cpill {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  /* hairline that sweeps the top edge on hover */
  .sig-cpill__edge {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, transparent, var(--color-brand-primary), transparent);
    transform: translateX(-100%);
    transition: transform 1.15s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  .sig-cpill:hover .sig-cpill__edge { transform: translateX(100%); }

  /* ── the pillar's imagery ───────────────────────────────────── */
  .sig-cpill__img {
    position: relative;
    z-index: 1;
    display: block;
    flex: none;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    opacity: 0.92;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-cpill__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .sig-cpill:hover .sig-cpill__img { transform: scale(1.035); opacity: 1; }

  .sig-cpill__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    flex: 1;
    padding: clamp(1.5rem, 2.2vw, 2rem);
  }

  .sig-cpill__top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .sig-cpill__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 12px;
    border: 1px solid rgba(255, 107, 53, 0.22);
    background: radial-gradient(120% 120% at 30% 0%, rgba(255, 107, 53, 0.16), rgba(255, 107, 53, 0.03));
    color: var(--color-brand-accent);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.5s ease, color 0.5s ease;
  }
  .sig-cpill__icon svg { width: 19px; height: 19px; }
  .sig-cpill:hover .sig-cpill__icon {
    transform: translateY(-3px) scale(1.04);
    border-color: rgba(255, 107, 53, 0.5);
    color: #fff;
  }

  .sig-cpill__name {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex: 1;
    min-width: 0;
    font-family: var(--font-heading);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--color-brand-primary);
  }
  .sig-cpill__name em {
    font-style: normal;
    font-size: 1.1em;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: rgba(255, 107, 53, 0.55);
    font-variant-numeric: tabular-nums;
  }
  .sig-cpill__claim {
    position: relative;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.24rem, 1.65vw, 1.5rem);
    line-height: 1.22;
    letter-spacing: -0.028em;
    color: #fff;
    max-width: 19ch;
  }
  .sig-cpill__subs {
    position: relative;
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 1.35rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .sig-cpill__subs li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .sig-cpill__tick {
    flex: none;
    width: 14px;
    height: 1px;
    background: var(--color-brand-primary);
    opacity: 0.8;
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-cpill:hover .sig-cpill__tick { width: 22px; }
  .sig-cpill__subname {
    font-size: 0.815rem;
    font-weight: 300;
    letter-spacing: 0.005em;
    color: rgba(237, 237, 237, 0.72);
  }

  .sig-cpill__cta {
    position: relative;
    margin-top: auto;
    padding-top: 1.6rem;
    display: block;
    width: 100%;
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: rgba(237, 237, 237, 0.75);
    transition: color 0.4s ease;
  }
  .sig-cpill__cta span { position: relative; }
  .sig-cpill__cta span::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    height: 1px;
    width: 100%;
    background: var(--color-brand-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-cpill__arrow,
  .sig-cpill__cta svg { display: inline-block; vertical-align: middle; margin-left: 0.5rem; transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
  .sig-cpill:hover .sig-cpill__cta { color: #fff; }
  .sig-cpill:hover .sig-cpill__cta span::after { transform: scaleX(1); }
  .sig-cpill:hover .sig-cpill__cta svg { transform: translateX(4px); }

  @media (max-width: 1080px) {
    .sig-cpillars__grid { grid-template-columns: 1fr; }
    .sig-cpill__claim { max-width: 26ch; }
  }
  @media (max-width: 640px) {
    .sig-cpill { border-radius: var(--sig-r-md); }
    /* the two-button group won't shrink (flex: none above), so once
       the title wraps to its own line, stack the buttons full-width
       instead of letting them overflow past the screen edge */
    .sig-cpillars__ctas {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .sig-cpillars__ctas .sig-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
