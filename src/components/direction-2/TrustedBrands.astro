---
import SectionHead from './SectionHead.astro';

const brands = [
  { file: 'brand-logo-39', name: 'Pos Malaysia' },
  { file: 'brand-logo-55', name: 'LG Electronics' },
  { file: 'brand-logo-60', name: 'Maxis' },
  { file: 'brand-logo-52', name: 'Gamuda Land' },
  { file: 'brand-logo-45', name: 'Tropicana Corporation Berhad' },
  { file: 'brand-logo-44', name: 'Lesaffre' },
  { file: 'brand-logo-40', name: 'SkyWorld' },
  { file: 'brand-logo-41', name: 'Glomac' },
  { file: 'brand-logo-43', name: 'Sunsuria' },
  { file: 'brand-logo-48', name: 'OSK Property' },
  { file: 'brand-logo-50', name: 'OCR Property' },
  { file: 'brand-logo-63', name: 'MKH' },
  { file: 'brand-logo-59', name: 'Reapfield, powered by KW Malaysia' },
  { file: 'brand-logo-57', name: 'Chiefway Smart Glass' },
  { file: 'brand-logo-58', name: 'Rayno' },
  { file: 'brand-logo-53', name: 'Cloudify.Asia' },
  { file: 'brand-logo-51', name: 'Aestra' },
  { file: 'brand-logo-61', name: 'Hot & Roll' },
  { file: 'brand-logo-64', name: 'Pet Universe' },
  { file: 'brand-logo-62', name: 'Yes Travel' },
];
---

<section class="sig-section sig-trust" id="trust">
  <div class="sig-shell">
    <div class="sig-trust__top">
      <SectionHead title="Trusted by <em>Brands</em>" />
      <p class="sig-trust__subhead">Multiple Industries. <em>One Growth Partner.</em></p>
      <p class="sig-lead sig-trust__lead">
        From ambitious local businesses to established brands, we help businesses across industries strengthen their digital presence and turn marketing into measurable results.
      </p>
    </div>

    <div class="sig-trust__grid" data-stagger data-stagger-amount="0.045">
      {
        brands.map((b) => (
          <div class="sig-trust__cell" data-r-item>
            <img
              src={`/images/brands/${b.file}.png`}
              alt={b.name}
              loading="lazy"
              decoding="async"
              width="300"
              height="120"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>

  .sig-trust__top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.9rem, 2vh, 1.3rem);
    padding-bottom: clamp(2.5rem, 5.5vh, 4rem);
  }
  .sig-trust__subhead {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.1rem, 2vw, 1.55rem);
    letter-spacing: -0.015em;
    color: rgba(237, 237, 237, 0.9);
  }
  .sig-trust__subhead em {
    font-style: normal;
    background: linear-gradient(90deg, var(--color-brand-primary), var(--color-brand-accent));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .sig-trust__lead { max-width: 60ch; }

  /* A calm grid, hairline-ruled — not a marquee. */
  .sig-trust__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.065);
    border-left: 1px solid rgba(255, 255, 255, 0.065);
    border-radius: 4px;
    overflow: hidden;
  }

  .sig-trust__cell {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(1.35rem, 3vw, 2.4rem) clamp(1rem, 2.4vw, 2rem);
    min-height: clamp(88px, 11vw, 128px);
    border-right: 1px solid rgba(255, 255, 255, 0.065);
    border-bottom: 1px solid rgba(255, 255, 255, 0.065);
    transition: background-color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-trust__cell::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(120% 120% at 50% 120%, rgba(255, 107, 53, 0.14), transparent 68%);
    transition: opacity 0.6s ease;
  }
  .sig-trust__cell:hover { background: rgba(23, 20, 15, 0.6); }
  .sig-trust__cell:hover::before { opacity: 1; }

  .sig-trust__cell img {
    position: relative;
    width: 100%;
    max-width: 132px;
    height: auto;
    max-height: 46px;
    object-fit: contain;
    /* Real client artwork is dark/coloured for light backgrounds.
       Inverting then desaturating lifts every mark to a light
       monochrome that keeps internal contrast (knock-out logos on
       coloured lock-ups stay legible), instead of flattening them
       to solid silhouettes. */
    filter: invert(1) grayscale(1) brightness(1.5) contrast(0.92);
    opacity: 0.44;
    transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
                filter 0.55s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-trust__cell:hover img {
    opacity: 1;
    transform: translateY(-2px);
    filter: invert(1) grayscale(1) brightness(1.6) contrast(0.92)
            drop-shadow(0 5px 20px rgba(255, 107, 53, 0.5));
  }

  @media (max-width: 1080px) {
    .sig-trust__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .sig-trust__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .sig-trust__cell img { max-height: 34px; }
  }
  @media (max-width: 440px) {
    .sig-trust__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sig-trust__cell { min-height: 76px; padding: 1.1rem 0.9rem; }
  }
</style>
