---
import SectionHead from './SectionHead.astro';

/*
  SIGNAL · About — Why One Search Pro
  ─────────────────────────────────────────────────────────────
  A four-part beat: the four-pillar rail (horizontal scroll-through,
  the same pin/scrub mechanic as SeoResults.astro's [data-hgallery]),
  a restrained "Moon vs Stars" statement, a second differentiator
  row styled to match the first, and a closing capstone — mirroring
  how SeoProcess.astro ends its rail with a "cycle continues" beat.
  Kept deliberately calm/typographic rather than illustrative, per
  the "elegant, high-class" direction.
*/

const pillars = [
  {
    idx: '01',
    title: 'Specialised Digital Marketing Teams',
    claim: 'The right expertise for the right challenge.',
    body: 'Our multidisciplinary team brings together specialists across strategy, SEO, performance marketing, social media, creative, content and digital development.',
  },
  {
    idx: '02',
    title: 'Professional Services With Clear SOPs',
    claim: 'Good work needs a good process behind it.',
    body: 'Clear workflows and structured SOPs help keep projects organised, communication aligned and execution moving in the right direction.',
  },
  {
    idx: '03',
    title: 'Live Reporting Dashboard',
    claim: "Know what's happening, not just what happened.",
    body: 'Our reporting approach gives clients greater visibility into campaign performance, making it easier to understand progress, results and opportunities for improvement.',
  },
  {
    idx: '04',
    title: 'Committed to Client Success',
    claim: 'Your objectives become our direction.',
    body: "We don't believe in executing simply for the sake of activity. We work to understand what matters to your business and build our approach around those objectives.",
  },
];

const apart = [
  {
    idx: '01',
    title: 'AI-Integrated Workflow',
    body: "We don't fear AI, we embrace AI and apply it seamlessly across creative, strategy, and optimisation.",
    image: '/images/about/apart/ai-workflow.jpg',
  },
  {
    idx: '02',
    title: 'Constant Training',
    body: 'Our team undergoes continuous upskilling to stay updated with the latest rules, regulations, and platform changes.',
    image: '/images/about/apart/training.jpg',
  },
  {
    idx: '03',
    title: 'Future-Ready Execution',
    body: 'With combined expertise alongside evolving knowledge, we deliver faster, smarter, and more reliable results than traditional setups.',
    image: '/images/about/apart/execution.jpg',
  },
];
---

<section class="sig-section sig-awhy" id="why-us">
  <div class="sig-awhy__stage" data-hgallery>
    <div class="sig-shell sig-awhy__stagehead">
      <SectionHead
        title="Different Expertise. <em>One Search Pro.</em>"
        lead="Great digital work rarely comes from one skill alone. Our strength comes from bringing specialised people, structured processes and a shared commitment to client success together."
      />
    </div>

    <div class="sig-awhy__grid" data-hgallery-track>
      {
        pillars.map((p) => (
          <article class="sig-awhy__card sig-glass" data-tilt="3" data-glow-target>
            <span class="sig-awhy__idx">{p.idx}</span>
            <h3 class="sig-awhy__title">{p.title}</h3>
            <p class="sig-awhy__claim">{p.claim}</p>
            <p class="sig-body sig-awhy__body">{p.body}</p>
          </article>
        ))
      }
    </div>
    <div class="sig-awhy__progress" aria-hidden="true">
      <span data-hgallery-progress></span>
    </div>
  </div>

  <!-- ── Moon vs Stars ─────────────────────────────────────── -->
  <div class="sig-awhy__cosmos-band">
    <span class="sig-awhy__cosmos-photo" aria-hidden="true"></span>
    <span class="sig-awhy__cosmos-vignette" aria-hidden="true"></span>
    <span class="sig-awhy__cosmos-tint" aria-hidden="true"></span>

    <div class="sig-shell">
      <div class="sig-awhy__cosmos">
        <div class="sig-awhy__body-col">
          <span class="sig-awhy__cosmos-eyebrow">The</span>
          <h3 class="sig-awhy__cosmos-word">Moon</h3>
          <p class="sig-awhy__cosmos-caption">The moon may glow,<br />yet it can't stop the rain pours.</p>
        </div>

        <div class="sig-awhy__vs" aria-hidden="true">
          <span class="sig-awhy__vs-line"></span>
          <span class="sig-awhy__vs-badge">V.S</span>
          <span class="sig-awhy__vs-line"></span>
        </div>

        <div class="sig-awhy__body-col sig-awhy__body-col--stars">
          <span class="sig-awhy__cosmos-eyebrow">The</span>
          <h3 class="sig-awhy__cosmos-word sig-awhy__cosmos-word--stars">Stars</h3>
          <p class="sig-awhy__cosmos-caption">But when the stars gather, brings enough light to guide you through any weather.</p>
        </div>
      </div>

      <p class="sig-awhy__cosmos-closer">
        Likewise, one person can only do so much, <strong>but a strong team changes everything.</strong>
      </p>
    </div>
  </div>

  <script>
    /* Moon vs Stars — bespoke sequential entrance. The sitewide
       reveals() only does vertical opacity/y with a flat per-item
       stagger; this needs directional left/right slides where the
       second block waits for the first to fully finish, so it gets
       its own small timeline instead (same pattern as this file's
       sibling components using local scripts for bespoke motion). */
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    function initCosmosEntrance() {
      const band = document.querySelector('.sig-awhy__cosmos-band');
      if (!band || band.dataset.entranceWired === '1') return;
      band.dataset.entranceWired = '1';

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const moon = band.querySelector('.sig-awhy__body-col');
      const stars = band.querySelector('.sig-awhy__body-col--stars');
      const closer = band.querySelector('.sig-awhy__cosmos-closer');
      if (!moon || !stars || !closer) return;

      gsap.timeline({ scrollTrigger: { trigger: band, start: 'top 75%', once: true } })
        .from(moon, { x: -60, opacity: 0, duration: 0.9, ease: 'power3.out' }, 0)
        .from(stars, { x: 60, opacity: 0, duration: 0.9, ease: 'power3.out' }, 0)
        .from(closer, { opacity: 0, duration: 0.6, ease: 'power2.out' });
    }

    /* "What Sets Us Apart" — sticky left column slides in from the
       left once; each stacked right-column card slides in from the
       right independently as it scrolls into view (they're now
       spread across real scroll distance, not one row appearing
       together, so each needs its own trigger rather than a group
       stagger). */
    function initApartEntrance() {
      const section = document.querySelector('.sig-awhy__apart');
      if (!section || section.dataset.entranceWired === '1') return;
      section.dataset.entranceWired = '1';

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const head = section.querySelector('.sig-awhy__apart-head');
      const cards = section.querySelectorAll('.sig-awhy__apart-grid .sig-awhy__card');
      if (!head || !cards.length) return;

      gsap.from(head, {
        x: -50,
        opacity: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: { trigger: head, start: 'top 80%', once: true },
      });

      cards.forEach((card) => {
        gsap.from(card, {
          x: 60,
          opacity: 0,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: { trigger: card, start: 'top 85%', once: true },
        });
      });
    }

    document.addEventListener('astro:page-load', initCosmosEntrance);
    document.addEventListener('astro:page-load', initApartEntrance);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCosmosEntrance);
      document.addEventListener('DOMContentLoaded', initApartEntrance);
    } else {
      initCosmosEntrance();
      initApartEntrance();
    }
  </script>

  <!-- ── What Sets Us Apart ────────────────────────────────── -->
  <div class="sig-shell">
    <div class="sig-awhy__apart">
      <div class="sig-awhy__apart-head">
        <h3 class="sig-h2 sig-awhy__apart-title">What Sets Us <em>Apart</em></h3>
        <p class="sig-lead sig-awhy__apart-lead">
          We're a full, specialised team built for real scalability. We're all in the same sky, but not the same in capability.
        </p>
      </div>

      <div class="sig-awhy__apart-grid">
        {
          apart.map((a) => (
            <article class="sig-awhy__card sig-glass" data-tilt="3" data-glow-target>
              <div class="sig-awhy__apart-photo">
                <img src={a.image} alt={a.title} loading="lazy" decoding="async" />
              </div>
              <span class="sig-awhy__idx">{a.idx}</span>
              <h4 class="sig-awhy__apart-label">{a.title}</h4>
              <p class="sig-body">{a.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* overflow-x (not the shorthand `overflow: hidden`) — per the CSS
     Overflow spec, pairing overflow-x:clip with the default
     overflow-y:visible does NOT force overflow-y to become a scroll
     container (that forcing only happens when the other axis is
     `hidden`/`scroll`/`auto`, not `clip`) — so this still contains
     horizontal bleed (the pinned pillar rail, the Moon vs Stars
     band) without breaking position:sticky on "What Sets Us Apart"'s
     left column below, the way the old `overflow: hidden` shorthand
     did. Same technique already used sitewide via `body { overflow-x:
     clip }` in about.astro. */
  .sig-awhy {
    overflow-x: clip;
    /* deliberate exception to the sitewide standard section gap on
       BOTH edges: this section's own pinned 4-pillar rail (below)
       already adds its own nav-clearance padding + vertical centering
       before its heading renders, so the WhoWeAre-facing top edge
       doesn't need the full standard padding either — same reasoning
       as the Culture-facing bottom edge */
    padding-top: clamp(0.5rem, 1vh, 0.75rem);
    /* Culture right after has its own pinned scroll-scrubbed crossfade
       (text -> carousel) that already reserves ~1.3 viewport-heights of
       scroll runway on its own, so this boundary doesn't need the full
       standard static padding on top of that — kept tight, matching
       Culture's own reduced top padding below */
    padding-bottom: clamp(0.5rem, 1vh, 0.75rem);
  }

  /* ── four-pillar rail ───────────────────────────────────── */
  .sig-awhy__stage { position: relative; margin-top: clamp(1.5rem, 3vh, 2.5rem); }

  /* the title now lives inside the stage (not a separate block above
     it) so it rides along with the pin and stays on-screen for the
     whole horizontal scrub instead of scrolling away before it starts */
  .sig-awhy__stagehead { margin-bottom: clamp(1.5rem, 3.5vh, 2.5rem); }
  /* wider than the shared SectionHead default so the intro wraps to
     2 lines instead of 4 — shortens the pinned head enough that it
     clears the fixed nav bar once it's centred inside the pin */
  .sig-awhy__stagehead :global(.sig-head__lead) { max-width: 86ch; }

  /* grid-first: the honest fallback for no-JS, reduced motion and
     narrow viewports — matches SeoResults.astro's pattern */
  .sig-awhy__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.4vw, 2rem);
    width: 100%;
    max-width: var(--sig-maxw);
    margin-inline: auto;
    padding-inline: var(--sig-gutter);
  }
  .sig-awhy__progress { display: none; }

  /* ── pinned, scroll-linked rail (added by SignalRuntime's
     generic hGallery(), same mechanic as the Results section) ── */
  .sig-awhy__stage.is-hpin {
    /* the base .sig-awhy__stage margin-top (above) is for the
       non-pinned stacked fallback only — once pinned, this padding-top
       alone provides nav clearance, so the margin is zeroed here to
       stop the two from stacking redundantly */
    margin-top: 0;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.75rem, 4vh, 3rem);
    /* nav clearance, reduced further still — kept to the smallest
       value that live-testing confirmed still clears the fixed nav */
    padding-top: clamp(1.25rem, 2.5vh, 2rem);
    overflow: hidden;
  }
  .sig-awhy__stage.is-hpin .sig-awhy__stagehead {
    flex: none;
    margin-bottom: 0;
  }
  .sig-awhy__stage.is-hpin .sig-awhy__grid {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    width: max-content;
    max-width: none;
    margin-inline: 0;
    gap: clamp(1.25rem, 2.4vw, 2.25rem);
    padding-inline: max(
      var(--sig-gutter),
      calc((100vw - var(--sig-maxw)) / 2 + var(--sig-gutter))
    );
    will-change: transform;
  }
  .sig-awhy__stage.is-hpin .sig-awhy__grid .sig-awhy__card {
    flex: 0 0 clamp(320px, 40vw, 480px);
  }
  .sig-awhy__stage.is-hpin .sig-awhy__progress {
    display: block;
    width: 100%;
    max-width: var(--sig-maxw);
    margin-inline: auto;
    padding-inline: var(--sig-gutter);
    border-top: 1px solid rgba(255, 255, 255, 0.075);
  }
  .sig-awhy__progress span {
    display: block;
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, var(--color-brand-primary), rgba(255, 169, 77, 0.35));
    box-shadow: 0 0 18px rgba(255, 107, 53, 0.5);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ── shared card (pillars + "what sets us apart") ───────── */
  .sig-awhy__card {
    position: relative;
    padding: clamp(1.75rem, 3.2vw, 2.5rem);
    border-radius: var(--sig-r-md);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-awhy__idx {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    color: var(--color-brand-primary);
    margin-bottom: 0.9rem;
  }
  .sig-awhy__title {
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0 0 0.6rem;
  }
  .sig-awhy__claim {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.98rem;
    color: rgba(255, 169, 77, 0.9);
    margin: 0 0 0.6rem;
  }
  .sig-awhy__body { max-width: 46ch; }

  /* ── Moon vs Stars — full-bleed photo band behind calm
     typographic labels ─────────────────────────────────────
     .sig-awhy already sets overflow:hidden, so the 100vw full-bleed
     trick below can't cause horizontal scroll. */
  .sig-awhy__cosmos-band {
    position: relative;
    isolation: isolate;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(36rem, 60vh, 46rem);
    padding-top: clamp(8rem, 16vh, 12rem);
    padding-bottom: clamp(3rem, 6vh, 4.5rem);
    overflow: hidden;
  }
  .sig-awhy__cosmos-photo,
  .sig-awhy__cosmos-vignette,
  .sig-awhy__cosmos-tint {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
    pointer-events: none;
  }
  .sig-awhy__cosmos-photo {
    background-image: url('/images/about/cosmos-bg.jpg');
    background-size: cover;
    background-position: center 35%;
    /* slow cinematic pan/zoom so the photo feels alive rather than
       a static poster behind the text */
    animation: sigAwhyCosmosPan 22s ease-in-out infinite alternate;
  }
  @keyframes sigAwhyCosmosPan {
    0%   { transform: scale(1) translate(0, 0); }
    100% { transform: scale(1.08) translate(-1%, -1%); }
  }
  /* fades the photo into the page's own black at the top/bottom edges
     instead of a hard rectangular seam, plus an overall darkening
     scrim so the captions stay legible over the sky */
  .sig-awhy__cosmos-vignette {
    background:
      linear-gradient(180deg, var(--color-brand-bg) 0%, transparent 22%, transparent 78%, var(--color-brand-bg) 100%),
      rgba(10, 6, 4, 0.4);
  }
  /* pulls the cool blue sky into the site's warm orange-on-black
     palette — mix-blend-mode:color recolors the blue moon side
     (which has real luminosity) while leaving the already-black
     starfield side essentially untouched (0 luminosity stays black).
     A slow breathing pulse (same technique as .sig-awhy__capstone-glow
     further down this file) keeps it from reading as a flat static tint. */
  .sig-awhy__cosmos-tint {
    background: rgba(255, 107, 53, 0.4);
    mix-blend-mode: color;
    animation: sigAwhyCosmosTintBreathe 9.5s ease-in-out infinite;
  }
  @keyframes sigAwhyCosmosTintBreathe {
    0%, 100% { opacity: 0.85; }
    50%      { opacity: 1; }
  }

  .sig-awhy__cosmos {
    margin: 0 auto;
    max-width: 56rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: flex-start;
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .sig-awhy__body-col {
    position: relative;
    display: flex;
    flex-direction: column;
    /* tight by default — "THE" should read as attached to its word;
       the caption gets its own breathing room via margin-top instead */
    gap: 0.3rem;
    /* both sides lean toward the centre V.S. divider — a "fight card"
       convergence instead of the words sitting at the row's outer edges */
    align-items: flex-end;
    text-align: right;
  }
  .sig-awhy__body-col--stars { align-items: flex-start; text-align: left; }

  .sig-awhy__cosmos-eyebrow {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(237, 237, 237, 0.55);
  }
  .sig-awhy__cosmos-word {
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .sig-awhy__cosmos-word--stars {
    background: linear-gradient(90deg, var(--color-brand-primary), var(--color-brand-accent));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .sig-awhy__cosmos-caption {
    margin-top: 0.75rem;
    font-size: 0.92rem;
    font-weight: 300;
    line-height: 1.6;
    color: rgba(237, 237, 237, 0.65);
    max-width: 32ch;
  }

  .sig-awhy__vs {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    /* previously align-self:stretch + height:100% centered the badge
       against the WHOLE eyebrow+word+caption column; sized naturally
       instead and nudged up to center specifically against the
       MOON/STARS word line */
    margin-top: -0.65rem;
  }
  .sig-awhy__vs-line {
    flex: 1;
    width: 1px;
    min-height: 2.5rem;
    background: linear-gradient(180deg, transparent, rgba(255, 107, 53, 0.4), transparent);
  }
  .sig-awhy__vs-badge {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-brand-primary);
    color: #17100b;
    font-family: var(--font-heading);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    box-shadow: 0 0 22px rgba(255, 107, 53, 0.55);
    animation: sigAwhyVsPulse 3.4s ease-in-out infinite;
  }
  @keyframes sigAwhyVsPulse {
    0%, 100% { transform: scale(1); box-shadow: 0 0 22px rgba(255, 107, 53, 0.55); }
    50%      { transform: scale(1.08); box-shadow: 0 0 30px rgba(255, 107, 53, 0.75); }
  }

  .sig-awhy__cosmos-closer {
    margin: clamp(3.5rem, 7vh, 5rem) auto 0;
    max-width: 52ch;
    text-align: center;
    font-size: clamp(1.02rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    color: rgba(237, 237, 237, 0.7);
  }
  .sig-awhy__cosmos-closer strong {
    font-weight: 600;
    /* inline-block — this phrase wraps across 2 lines, and a plain
       inline element's gradient background is positioned against the
       combined bounding box of every wrapped fragment, splitting the
       gradient's colors unevenly line to line; inline-block paints it
       as one contiguous box instead (same fix used on AboutCta.astro's
       "Conversation." gradient) */
    display: inline-block;
    background: linear-gradient(90deg, var(--color-brand-primary), var(--color-brand-accent));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  /* ── What Sets Us Apart — sticky left column, stacked right ── */
  .sig-awhy__apart {
    /* the sticky head below uses translateY(-50%) to center itself,
       which applies unconditionally from first paint (not only once
       actually "stuck") — that silently eats roughly half the head's
       own rendered height out of whatever gap is authored here, so
       this is boosted well beyond the visual target to compensate */
    margin-top: clamp(11rem, 20vh, 15rem);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4rem);
    /* start, not center — centering the sticky head against the
       FULL height of the (very tall, 3-stacked-card) row pushes its
       static position down past half that height, so it stays out
       of view until the scroll is already halfway through. Instead,
       the head fills the viewport itself (below) and centers its
       own content, which stays visible and centered immediately. */
    align-items: start;
  }
  .sig-awhy__apart-head {
    /* sticks centered in the viewport via top:50%+translateY, instead
       of forcing its own box to min-height:100vh — that approach kept
       the head visually centered too, but also inflated the WHOLE
       grid row (including the space after the last stacked card) to
       at least a full viewport tall whenever the 3-card column was
       naturally shorter than that, leaving a large dead gap before
       whatever section follows. This centers the same way without
       affecting the row's own height. */
    position: sticky;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.25vw, 1.5rem);
  }
  .sig-awhy__apart-title { max-width: 10ch; }
  .sig-awhy__apart-lead { max-width: 40ch; }

  .sig-awhy__apart-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(0.85rem, 1.4vw, 1.2rem);
  }
  /* shrink just these 3 stacked cards (not the unrelated pillar-rail
     cards higher up the page, which also use .sig-awhy__card) so the
     sticky-scroll column is meaningfully shorter — Round 88, tightened
     further in Round 89 */
  .sig-awhy__apart-grid .sig-awhy__card {
    padding: clamp(1rem, 1.6vw, 1.4rem);
  }
  .sig-awhy__apart-label {
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0 0 0.6rem;
  }
  .sig-awhy__apart-grid .sig-awhy__card p { max-width: none; }
  .sig-awhy__apart-photo {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 4.2;
    overflow: hidden;
    border-radius: var(--sig-r-sm);
    margin-bottom: 1rem;
  }
  .sig-awhy__apart-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    display: block;
  }

  @media (max-width: 1080px) {
    /* sticky is switched off below (position:static) at this width,
       so it's safe here to clip the entrance slide-in's transient
       off-canvas transform without the sticky-breaking side effect
       that overflow:hidden has on the desktop layout above */
