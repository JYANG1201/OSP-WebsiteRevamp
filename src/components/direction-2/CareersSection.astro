---
/*
  SIGNAL · Contact — Careers
  ─────────────────────────────────────────────────────────────
  Folded into the Contact Us page per request (not a separate
  route). Real copy/perks pulled from the live site's /career/
  page. Positions now come from the `careers` content collection
  (real job postings migrated from the live site's WP Job Openings
  plugin) — each links to its own real subpage instead of going
  straight to mailto (the subpage itself keeps that mailto CTA).
*/
import { getCollection } from 'astro:content';

const perks = [
  {
    title: 'Performance',
    body: 'Work closely with well-known brands and showcase your talents.',
    icon: '<path d="M3 17l6-6 4 4 8-8M15 7h6v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  },
  {
    title: 'Environment',
    body: 'A comfortable, youthful and modern working environment.',
    icon: '<path d="M18 4c-7 0-12 5-12 12 0 1 .1 2 .3 3C13 18 18 12 18 4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="none"/><path d="M6.3 19C9 15 13 11 18 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/>',
  },
  {
    title: 'Allowance',
    body: 'Performance-based compensation included in every remuneration package.',
    icon: '<circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M12 7.5v9M9.5 9.5c0-1 1-1.5 2.5-1.5s2.5.6 2.5 1.6c0 2.2-5 1-5 3.2 0 1 1 1.6 2.5 1.6s2.5-.5 2.5-1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" fill="none"/>',
  },
  {
    title: 'Work From Home',
    body: 'One day a week to work from home and cut down on commute time.',
    icon: '<path d="M4 11.5 12 4l8 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M6 10v9h12v-9" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/><path d="M10 19v-5h4v5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="none"/>',
  },
  {
    title: 'Work-Life Balance',
    body: 'A positive workplace culture that prioritises your mental and physical health.',
    icon: '<path d="M12 20s-7-4.35-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 5c-2.5 4.65-9.5 9-9.5 9Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="none"/>',
  },
];

const positionOrder = [
  'internship-for-sales-support',
  'administrative-assistant',
  'sales-executive-for-digital-marketing',
  'seo-executive-junior-senior',
  'digital-marketing-executive-junior-senior',
  'internship-for-digital-marketing',
];
const positions = (await getCollection('careers')).sort(
  (a, b) => positionOrder.indexOf(a.id) - positionOrder.indexOf(b.id)
);
---

<section class="sig-section sig-careers" id="careers">
  <div class="sig-shell">
    <div class="sig-careers__head" data-stagger>
      <p class="sig-meta" data-r-item>Join The Team</p>
      <h2 class="sig-h2 sig-careers__title" data-r-item>
        We Are <em>Recruiting.</em>
      </h2>
      <p class="sig-lead sig-careers__lead" data-r-item>
        Join our team and unleash your full potential in a role with real career-growth opportunities.
      </p>
    </div>

    <div class="sig-careers__perks" data-stagger data-stagger-amount="0.08">
      {
        perks.map((p) => (
          <div class="sig-careers__perk sig-glass sig-glass--flat" data-tilt="3" data-r-item>
            <div class="sig-careers__perk-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" set:html={p.icon} />
            </div>
            <h3 class="sig-careers__perk-title">{p.title}</h3>
            <p class="sig-careers__perk-body">{p.body}</p>
          </div>
        ))
      }
    </div>

    <div class="sig-careers__panel">
      <div class="sig-careers__positions" data-stagger data-stagger-amount="0.06">
        <p class="sig-meta sig-careers__positions-label" data-r-item>Open Positions</p>
        {
          positions.map((p) => (
            <a class="sig-careers__position" href={`/careers/${p.id}/`} data-r-item>
              <span class="sig-careers__position-title">{p.data.title}</span>
              <span class="sig-careers__position-dept">{p.data.department}</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          ))
        }
      </div>

      <div class="sig-careers__apply" data-r>
        <p class="sig-body">
          Don't see the exact role? Send your resume anyway — we're always looking for people who make things better.
        </p>
        <a class="sig-btn sig-btn--primary" href="mailto:hr@onesearchpro.my" data-glow-target>
          Apply Now
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .sig-careers__head {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 60ch;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  .sig-careers__title { color: #fff; }
  .sig-careers__lead { max-width: 52ch; }

  .sig-careers__perks {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.85rem, 1.6vw, 1.25rem);
    margin-bottom: clamp(3rem, 7vh, 4.5rem);
  }
  .sig-careers__perk {
    padding: clamp(1.4rem, 2.5vw, 1.9rem) clamp(1.15rem, 2vw, 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .sig-careers__perk-icon {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
    margin-bottom: 0.15rem;
  }
  /* Allowance (3rd perk) — currency-symbol icon reads correctly mirrored */
  .sig-careers__perk:nth-child(3) .sig-careers__perk-icon svg {
    transform: scaleX(-1);
  }
  .sig-careers__perk-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
    background: linear-gradient(90deg, var(--color-brand-primary), var(--color-brand-accent));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .sig-careers__perk-body {
    font-size: 0.85rem;
    font-weight: 300;
    line-height: 1.6;
    color: rgba(237, 237, 237, 0.62);
  }

  .sig-careers__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .sig-careers__positions { display: flex; flex-direction: column; }
  .sig-careers__positions-label { margin-bottom: 0.9rem; }
  .sig-careers__position {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 0.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    color: rgba(237, 237, 237, 0.85);
    transition: color 0.35s ease, padding-left 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-careers__positions > a:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.09); }
  .sig-careers__position-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.98rem;
  }
  .sig-careers__position-dept {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-muted);
  }
  .sig-careers__position svg { flex: none; color: var(--color-brand-primary); transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
  .sig-careers__position:hover {
    color: #fff;
    padding-left: 0.75rem;
  }
  .sig-careers__position:hover svg { transform: translateX(4px); }

  .sig-careers__apply {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--sig-r-md);
    background: rgba(255, 107, 53, 0.06);
    border: 1px solid rgba(255, 107, 53, 0.16);
  }
  .sig-careers__apply .sig-body { max-width: none; }

  @media (max-width: 1080px) {
    .sig-careers__perks { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .sig-careers__panel { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .sig-careers__perks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sig-careers__position { grid-template-columns: 1fr auto; }
    .sig-careers__position-dept { display: none; }
  }
</style>
