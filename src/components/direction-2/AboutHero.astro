---
/*
  SIGNAL · About Us hero
  ─────────────────────────────────────────────────────────────
  Same composition as the homepage/SEO hero: full-bleed video
  ground, one dark scrim, headline + lead + dual CTA. Uses its own
  footage (light-reflection.mp4) rather than the shared hero video.
*/
---

<section class="sig-ahero" data-hero>
  <div class="sig-ahero__media" aria-hidden="true">
    <video
      class="sig-hero-video"
      autoplay
      muted
      loop
      playsinline
      poster="/images/posters/light-reflection.jpg"
    >
      <source src="/videos/light-reflection-m.mp4" type="video/mp4" media="(max-width: 860px)" />
      <source src="/videos/light-reflection.mp4" type="video/mp4" />
    </video>
    <div class="sig-ahero__scrim"></div>
  </div>

  <div class="sig-shell sig-ahero__inner">
    <p class="sig-ahero__kicker" data-hero-el>More Than an Agency.</p>

    <h1 class="sig-ahero__title">
      <span class="sig-ahero__line"><i data-hero-line>A Team Built for <em>Digital Growth.</em></i></span>
    </h1>

    <p class="sig-ahero__lead" data-hero-el>
      Since 2017, One Search Pro has been helping businesses navigate an ever-changing digital landscape through strategy, performance, technology and creative thinking. We bring specialised expertise together under one roof — giving brands one integrated team to plan, create, execute and grow.
    </p>

    <div class="sig-ahero__actions" data-hero-el>
      <a class="sig-btn sig-btn--primary sig-ahero__cta" href="/#services" data-glow-target>
        View Our Services
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a class="sig-btn sig-btn--ghost sig-ahero__cta" href="/#contact-cta">
        Work With Us
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .sig-ahero {
    position: relative;
    isolation: isolate;
    min-height: min(92svh, 940px);
    padding-top: clamp(8rem, 20vh, 13rem);
    padding-bottom: var(--sig-section);
    margin-bottom: var(--sig-hero-gap);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .sig-ahero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .sig-ahero__media .sig-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    /* this footage fades to near-black at its own top/bottom edges
       (a real feature of the source, confirmed by sampling brightness
       across the full loop) — at this hero's wide, short aspect
       ratio, object-fit:cover doesn't crop enough to keep that fade
       off-screen, so it shows as a dark band at the bottom. Scaling
       up crops further in on all sides (clipped by .sig-ahero's own
       overflow:hidden), pushing the visible window into the
       brighter, more active middle of the frame. */
    transform: scale(1.22);
    filter: saturate(1.04) contrast(1.02) brightness(0.9);
  }
  /* this footage's own vignette can't be fully cropped out (see the
     scale note above) — a bottom-fade scrim turns whatever darkness
     remains into a deliberate cinematic fade into the page's own
     background, instead of reading as a hard cutoff. Stays fully
     transparent through the upper ~60% so the light-beam content
     isn't washed out. */
  .sig-ahero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      transparent 0%,
      transparent 58%,
      rgba(5, 5, 5, 0.5) 80%,
      rgba(5, 5, 5, 0.96) 100%);
  }
  .sig-ahero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.1rem, 2.2vh, 1.6rem);
  }

  .sig-ahero__kicker {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-accent);
  }

  .sig-ahero__title {
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(2.75rem, 6.4vw, 5.6rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: #fff;
    max-width: 18ch;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.45);
  }
  .sig-ahero__title em {
    font-style: normal;
    background-image:
      linear-gradient(100deg, transparent 40%, rgba(255, 255, 255, 0.85) 50%, transparent 60%),
      linear-gradient(90deg, var(--color-brand-primary), var(--color-brand-accent));
    background-size: 220% 100%, 100% 100%;
    background-position: var(--shine, -120%) 0, 0 0;
    background-repeat: no-repeat, no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    /* filter (not text-shadow) — text-shadow draws behind the
       transparent-fill glyphs and shows through as a muddy cast over
       the gradient; drop-shadow uses the rendered alpha shape instead. */
    text-shadow: none;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
  }
  .sig-ahero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.16em;
    margin-bottom: -0.16em;
  }
  .sig-ahero__line i { display: block; font-style: normal; }

  .sig-ahero__lead {
    font-weight: 300;
    font-size: clamp(1.02rem, 1.3vw, 1.22rem);
    line-height: 1.66;
    letter-spacing: -0.005em;
    color: rgba(237, 237, 237, 0.78);
    max-width: 58ch;
    text-shadow: none;
  }

  .sig-ahero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.1rem;
    padding-top: 0.4rem;
  }

  @media (max-width: 1080px) {
    .sig-ahero__title { max-width: 20ch; }
  }
  @media (max-width: 640px) {
    .sig-ahero {
      padding-top: 7.5rem;
      min-height: min(92svh, 760px);
    }
    .sig-ahero__title { max-width: none; letter-spacing: -0.035em; }
    .sig-ahero__cta { width: 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sig-ahero__media .sig-hero-video { display: none; }
    .sig-ahero__media {
      background-image: url('/images/placeholder/hero-poster-signal.svg');
      background-size: cover;
      background-position: center;
    }
  }
</style>
