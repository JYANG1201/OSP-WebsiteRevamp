---
import SectionHead from './SectionHead.astro';

/*
  SIGNAL · Search results
  ─────────────────────────────────────────────────────────────
  The page's signature scroll moment. SignalRuntime pins this
  section and converts vertical scroll into horizontal card
  travel (ScrollTrigger · pin + scrub, soft throughout).

  With JS off, at reduced motion, or on narrow screens the track
  is a plain responsive grid — the markup is authored grid-first
  and only switches to the moving rail once the runtime adds
  `.is-hpin`.

  Sector descriptors only — invented figures are never attached to
  a named client or a real logo.
*/

const cases = [
  {
    art: 1,
    image: '/images/seo-results/logistics.jpg',
    sector: 'National postal & logistics',
    pillar: 'Technical SEO',
    tags: ['Technical', 'Content'],
    title: 'Eleven competing service pages became one hub that owns the category.',
    stats: [
      { v: '+340%', l: 'organic traffic' },
      { v: '+118%', l: 'tracked enquiries' },
      { v: '24', l: 'terms at position 1' },
    ],
  },
  {
    art: 2,
    image: '/images/seo-results/healthcare.jpg',
    sector: 'Multi-location healthcare',
    pillar: 'Local SEO',
    tags: ['Local', 'Reputation'],
    title: 'Twelve clinics, twelve local footprints, one consistent brand.',
    stats: [
      { v: '+415%', l: 'map-pack impressions' },
      { v: '+146%', l: 'booked appointments' },
      { v: '12/12', l: 'clinics in local top 3' },
    ],
  },
  {
    art: 6,
    image: '/images/seo-results/b2b.jpg',
    sector: 'B2B software & platforms',
    pillar: 'AI SEO',
    tags: ['AI SEO', 'Strategy'],
    title: 'Cited by the answer engine before the competitor list loads.',
    stats: [
      { v: '68', l: 'AI Overview citations' },
      { v: '+187%', l: 'non-brand clicks' },
      { v: '3.1×', l: 'demo requests' },
    ],
  },
];
---

<section class="sig-section sig-sres" id="seo-results">
  <div class="sig-sres__stage" data-hgallery>
    <div class="sig-shell">
      <div class="sig-sres__head">
        <SectionHead title="SEARCH <em>RESULTS</em>" />
        <a class="sig-btn sig-btn--primary sig-btn--sm sig-sres__req" href="/contact">
          Request the full case studies
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="sig-sres__track" data-hgallery-track>
      {
        cases.map((c) => (
          <article class="sig-scase sig-glass" data-tilt="3" data-glow-target tabindex="0">
            <img class="sig-scase__cover" src={c.image} alt={`${c.sector} — One Search Pro case study`} loading="lazy" decoding="async" />

            <div class="sig-scase__face">
              <header class="sig-scase__meta">
                <span class="sig-scase__sector">{c.sector}</span>
                <ul class="sig-scase__tags">
                  {c.tags.map((t) => <li>{t}</li>)}
                </ul>
              </header>
              <h3 class="sig-scase__title">{c.title}</h3>
              <span class="sig-scase__pillar">{c.pillar}</span>
            </div>

            <dl class="sig-scase__stats">
              {c.stats.map((s) => (
                <div class="sig-scase__stat">
                  <dt>{s.v}</dt>
                  <dd>{s.l}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>

    <div class="sig-sres__progress" aria-hidden="true">
      <span data-hgallery-progress></span>
    </div>
  </div>
</section>

<style>
  .sig-sres__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem 3rem;
    flex-wrap: wrap;
    padding-bottom: clamp(2.75rem, 6vh, 4.5rem);
  }
  /* ── stage ──────────────────────────────────────────────── */
  .sig-sres__stage { position: relative; }

  /* grid-first: the honest fallback for no-JS, reduced motion and
     narrow viewports */
  .sig-sres__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.5rem);
    width: 100%;
    max-width: var(--sig-maxw);
    margin-inline: auto;
    padding-inline: var(--sig-gutter);
    perspective: 1800px;
  }

  .sig-sres__progress { display: none; }

  /* ── pinned, scroll-linked rail (added by SignalRuntime) ── */
  .sig-sres__stage.is-hpin {
    /* GSAP's pin mechanism measures and freezes this element's height
       ONCE, at ScrollTrigger setup time — before the section has ever
       scrolled, i.e. before .is-pin-live (and the nav-clearance
       padding-top it adds below) has ever been applied. That frozen
       height then becomes a hard inline height/max-height for the
       entire pin, which plain CSS (including a later min-height on
       .is-pin-live) cannot override. So the extra room this section
       needs once genuinely pinned has to already be reserved here,
       unconditionally, or the card's bottom gets clipped by this
       element's own overflow:hidden the moment it goes live —
       confirmed live via getBoundingClientRect before vs. during pin. */
    min-height: max(68svh, 48rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.75rem, 4vh, 3rem);
    overflow: hidden;
  }
  /* nav clearance — only while genuinely stuck (position:fixed) under
     the fixed nav. This CANNOT live on .sig-sres__stage itself (even
     gated behind .is-pin-live): GSAP's pin mechanism sets an inline
     `padding: 0px` directly on the pinned element to normalize its box
     model, which always wins over any CSS class — confirmed live, the
     stage's own padding-top was silently discarded the instant it
     became pinned. It also can't just move to a child while
     `justify-content: center` stays active: centering distributes any
     extra height a child gains from its own padding symmetrically
     above/below, not purely downward — confirmed live, the heading
     shifted UP once pinned instead of down. So once actually stuck,
     switch to top-anchored layout (flex-start) and let this child's
     own padding-top do the pushing — GSAP never touches this child,
     and top-anchored content no longer fights the padding's intent.
     Only applies while actually stuck, not during ordinary pre-pin
     scrolling. Verified across 700/768/800/900/1080px heights. */
  .sig-sres__stage.is-pin-live {
    justify-content: flex-start;
  }
  .sig-sres__stage.is-pin-live .sig-sres__head {
    padding-top: clamp(6rem, 6.5vh, 6.5rem);
  }
  .sig-sres__stage.is-hpin .sig-sres__track {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    width: max-content;
    max-width: none;
    margin-inline: 0;
    gap: clamp(1.25rem, 2.4vw, 2.25rem);
    padding-inline: max(
      var(--sig-gutter),
      calc((100vw - var(--sig-maxw)) / 2 + var(--sig-gutter))
    );
    will-change: transform;
  }
  .sig-sres__stage.is-hpin .sig-scase {
    flex: 0 0 clamp(280px, 32vw, 440px);
  }
  /* the head now lives inside the pinned stage (so its CTA stays on
     screen for the whole slide) — keep it from shrinking in the
     column flex layout, and drop its own bottom padding so spacing
     to the track comes only from the stage's own flex gap, not both
     stacked together */
  .sig-sres__stage.is-hpin > .sig-shell {
    flex: none;
    width: 100%;
  }
  .sig-sres__stage.is-hpin .sig-sres__head {
    padding-bottom: 0;
  }

  .sig-sres__stage.is-hpin .sig-sres__progress {
    display: block;
    width: 100%;
    max-width: var(--sig-maxw);
    margin-inline: auto;
    padding-inline: var(--sig-gutter);
  }
  .sig-sres__progress span {
    display: block;
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, var(--color-brand-primary), rgba(255, 169, 77, 0.35));
    box-shadow: 0 0 18px rgba(255, 107, 53, 0.5);
    transform: scaleX(0);
    transform-origin: left;
  }
  .sig-sres__stage.is-hpin .sig-sres__progress {
    border-top: 1px solid rgba(255, 255, 255, 0.075);
  }

  /* ── case card ──────────────────────────────────────────── */
  .sig-scase {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    outline-offset: 4px;
  }

  /* :global() because the cover is PlaceholderImage's root element and
     therefore carries that component's scope id, not this one's. */
  .sig-scase :global(.sig-scase__cover) {
    position: relative;
    z-index: 1;
    flex: none;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center;
    display: block;
    opacity: 0.92;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sig-scase:hover :global(.sig-scase__cover),
  .sig-scase:focus-visible :global(.sig-scase__cover) {
    transform: scale(1.045);
    opacity: 1;
  }
  /* the rail is height-constrained by the viewport — take a little off
     the cover so a card always fits inside the pinned stage */
  .sig-sres__stage.is-hpin .sig-scase :global(.sig-scase__cover) {
    aspect-ratio: 16 / 9;
  }

  .sig-scase__face {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    padding: clamp(1.1rem, 1.8vw, 1.5rem) clamp(1.1rem, 1.8vw, 1.6rem) 0;
  }
  .sig-scase__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .sig-scase__sector {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 169, 77, 0.9);
    line-height: 1.5;
  }
  .sig-scase__tags {
    list-style: none;
    display: flex;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
  }
  .sig-scase__tags li {
    font-size: 0.55rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(5, 5, 5, 0.35);
    color: rgba(237, 237, 237, 0.72);
    white-space: nowrap;
  }
  .sig-scase__title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.1rem, 1.45vw, 1.34rem);
    line-height: 1.28;
    letter-spacing: -0.028em;
    color: #fff;
    text-wrap: balance;
  }
  .sig-scase__pillar {
    display: inline-flex;
    align-items: center;
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-brand-primary);
  }

  .sig-scase__stats {
    position: relative;
    z-index: 2;
    margin: auto 0 0;
    padding: clamp(1rem, 1.8vh, 1.3rem) clamp(1.1rem, 1.8vw, 1.6rem) clamp(1.1rem, 1.8vw, 1.5rem);
    display: flex;
    gap: clamp(0.75rem, 1.4vw, 1.2rem);
  }
  .sig-scase__stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }
  .sig-scase__stat + .sig-scase__stat {
    padding-left: clamp(0.75rem, 1.4vw, 1.2rem);
    border-left: 1px solid rgba(255, 255, 255, 0.09);
  }
  .sig-scase__stat dt {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.85vw, 1.62rem);
    letter-spacing: -0.04em;
    line-height: 1;
    color: #fff;
    transition: color 0.5s ease;
  }
  .sig-scase:hover .sig-scase__stat dt { color: var(--color-brand-accent); }
  .sig-scase__stat dd {
    font-size: 0.57rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.5;
    color: rgba(237, 237, 237, 0.55);
  }

  /* ── responsive (fallback grid only — the rail is JS-gated) ── */
  @media (max-width: 1080px) {
    .sig-sres__track { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sig-sres__track > .sig-scase:last-child { grid-column: span 2; }
  }
  @media (max-width: 760px) {
    .sig-sres__track { grid-template-columns: 1fr; }
    .sig-scase { border-radius: var(--sig-r-md); }
    .sig-sres__track > .sig-scase:last-child { grid-column: span 1; }
  }
  @media (max-width: 420px) {
    .sig-scase__stats { flex-direction: column; gap: 0.9rem; }
    .sig-scase__stat + .sig-scase__stat { padding-left: 0; border-left: 0; }
  }
</style>
