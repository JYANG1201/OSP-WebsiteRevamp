    path: 'M3.2 6.4h2.6V14H3.2V6.4Zm1.3-3.6a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM7.6 6.4h2.5v1.04h.04c.35-.63 1.2-1.24 2.35-1.24 1.98 0 2.55 1.22 2.55 3.06V14h-2.6v-3.9c0-.93-.36-1.5-1.15-1.5-.86 0-1.24.58-1.24 1.53V14H7.6V6.4Z',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/onesearchpro/',
    path: 'M9 2.7c-1.71 0-1.93.01-2.6.04-.67.03-1.13.14-1.53.3-.41.16-.76.37-1.11.72-.35.35-.56.7-.72 1.11-.16.4-.27.86-.3 1.53C2.71 7.07 2.7 7.29 2.7 9s.01 1.93.04 2.6c.03.67.14 1.13.3 1.53.16.41.37.76.72 1.11.35.35.7.56 1.11.72.4.16.86.27 1.53.3.67.03.89.04 2.6.04s1.93-.01 2.6-.04c.67-.03 1.13-.14 1.53-.3.41-.16.76-.37 1.11-.72.35-.35.56-.7.72-1.11.16-.4.27-.86.3-1.53.03-.67.04-.89.04-2.6s-.01-1.93-.04-2.6c-.03-.67-.14-1.13-.3-1.53a3.07 3.07 0 0 0-.72-1.11 3.07 3.07 0 0 0-1.11-.72c-.4-.16-.86-.27-1.53-.3-.67-.03-.89-.04-2.6-.04Zm0 1.14c1.68 0 1.88.01 2.55.04.61.03.94.13 1.16.22.29.11.5.25.72.47.22.22.36.43.47.72.09.22.19.55.22 1.16.03.67.04.87.04 2.55s-.01 1.88-.04 2.55c-.03.61-.13.94-.22 1.16-.11.29-.25.5-.47.72-.22.22-.43.36-.72.47-.22.09-.55.19-1.16.22-.67.03-.87.04-2.55.04s-1.88-.01-2.55-.04c-.61-.03-.94-.13-1.16-.22a1.93 1.93 0 0 1-.72-.47 1.93 1.93 0 0 1-.47-.72c-.09-.22-.19-.55-.22-1.16-.03-.67-.04-.87-.04-2.55s.01-1.88.04-2.55c.03-.61.13-.94.22-1.16.11-.29.25-.5.47-.72.22-.22.43-.36.72-.47.22-.09.55-.19 1.16-.22.67-.03.87-.04 2.55-.04Zm0 1.94a3.22 3.22 0 1 0 0 6.44 3.22 3.22 0 0 0 0-6.44Zm0 5.31a2.09 2.09 0 1 1 0-4.18 2.09 2.09 0 0 1 0 4.18Zm4.1-5.44a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z',
