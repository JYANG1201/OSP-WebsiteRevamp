---
/*
  SIGNAL · Contact — form + real details
  ─────────────────────────────────────────────────────────────
  The form fields/validation/success-swap are the same pattern as
  ConsultationCta.astro (homepage's #contact-cta) — same UI-only
  behavior, no backend wired up yet. Details/socials are the real
  ones from the live site's contact page.
*/
const details = [
  { label: 'Phone', value: '03 3009 5471', href: 'tel:+60330095471' },
  { label: 'Email', value: 'info@onesearchpro.my', href: 'mailto:info@onesearchpro.my' },
